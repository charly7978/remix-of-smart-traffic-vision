{
    "python.defaultInterpreterPath": "${workspaceFolder}/server/.venv/Scripts/python.exe",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/server",
        "${workspaceFolder}/server/.venv/Lib/site-packages"
    ],
    "python.analysis.autoSearchPaths": true,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.ignore": [
        "**/__pyrefly_virtual__/**",
        "**/__pyrefly_virtual__*"
    ],
    "files.exclude": {
        "**/__pyrefly_virtual__/**": true
    },
    "files.watcherExclude": {
        "**/__pyrefly_virtual__/**": true
    },
    "github.copilot.chat.anthropic.tools.websearch.enabled": true,
    "github.copilot.chat.alternateGptPrompt.enabled": true,
    "github.copilot.chat.alternateGeminiModelFPrompt.enabled": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.claudeAgent.useSdkExtension": true,
    "github.copilot.chat.claudeAgent.allowAutoPermissions": true
}